rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.nickname is string && data.nickname.size() >= 2 && data.nickname.size() <= 40 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 100)) &&
             (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 300)) &&
             (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 600)) &&
             (!('favoriteGame' in data) || data.favoriteGame == null || (data.favoriteGame is string && data.favoriteGame.size() <= 30)) &&
             (!('totalScore' in data) || data.totalScore == null || data.totalScore is int) &&
             (!('streakDays' in data) || data.streakDays == null || data.streakDays is int) &&
             (!('matchesPlayed' in data) || data.matchesPlayed == null || data.matchesPlayed is int) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time + duration.value(5, 'm')));
    }

    function isValidScore(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.gameType in ['termo', 'globle', 'sizeitup'] &&
             data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.score is int && data.score >= 0 && data.score <= 100 &&
             (!('rawText' in data) || data.rawText == null || (data.rawText is string && data.rawText.size() <= 2000)) &&
             (!('details' in data) || data.details == null || (data.details is string && data.details.size() <= 500)) &&
             (!('nickname' in data) || data.nickname == null || (data.nickname is string && data.nickname.size() <= 50)) &&
             (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 600));
    }

    function isValidActivity(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.playerName is string && data.playerName.size() <= 50 &&
             data.gameName is string && data.gameName.size() <= 30 &&
             data.pointsEarned is int && data.pointsEarned >= 0 && data.pointsEarned <= 100 &&
             (!('gameLetter' in data) || data.gameLetter == null || (data.gameLetter is string && data.gameLetter.size() <= 5)) &&
             (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 600)) &&
             (!('fireReactions' in data) || data.fireReactions == null || data.fireReactions is int) &&
             (!('applauseReactions' in data) || data.applauseReactions == null || data.applauseReactions is int) &&
             (!('targetReactions' in data) || data.targetReactions == null || data.targetReactions is int);
    }

    // User Profiles
    match /users/{userId} {
      allow get, list: if true;
      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'nickname', 'createdAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time + duration.value(5, 'm') &&
                       isValidUser(incoming());
      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUser(incoming());
      allow delete: if false;
    }

    // Daily Scores
    match /scores/{scoreId} {
      allow get, list: if true;
      allow create: if isSignedIn() &&
                       isValidId(scoreId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'gameType', 'dateKey', 'score', 'createdAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time + duration.value(5, 'm') &&
                       isValidScore(incoming());
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // Activity Feed & Social Reactions
    match /activities/{activityId} {
      allow get, list: if true;
      allow create: if isSignedIn() &&
                       isValidId(activityId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'playerName', 'gameName', 'pointsEarned', 'createdAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time + duration.value(5, 'm') &&
                       isValidActivity(incoming());
      allow update: if isSignedIn() &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['fireReactions', 'applauseReactions', 'targetReactions']);
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
